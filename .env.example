# Copy to .env and fill in what you need. .env is gitignored — never commit it.
# Everything here is optional: with no keys at all the app runs in replay mode
# off the committed fixtures, which is the mode the demo runs in.

# ---- which mode the ports run in ----------------------------------------
# replay | live | record
#   replay  read the committed recordings. No network, no keys, no surprises.
#   live    call the providers; fall back to a recording if a call fails, and
#           say so rather than hiding it.
#   record  call the providers and overwrite the recordings.
DOWNSTREAM_PORTS=replay

# ---- travel data (only read in live or record) --------------------------
# Duffel, test mode. Real airlines, real routes, cannot take money.
# app.duffel.com -> Test mode -> Developers -> Access tokens
# DUFFEL_TOKEN=duffel_test_...

# AeroDataBox is sold THROUGH RapidAPI, so this is a RapidAPI key, not an
# AeroDataBox one. rapidapi.com -> AeroDataBox -> subscribe to Basic (free).
# RAPIDAPI_KEY=...

# LiteAPI sandbox, for hotels. liteapi.travel -> API keys -> sandbox.
# LITEAPI_KEY=sand_...

# ---- the model (optional) -----------------------------------------------
# bedrock | anthropic | none.  "none" is a supported mode, not a broken one:
# fare-rule parsing and the plan rationale both have deterministic fallbacks.
LLM_PROVIDER=none

# LLM_PROVIDER=bedrock — AWS_PROFILE works on a laptop; on Render use the two
# keys instead, because ~/.aws/credentials does not exist in a container.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-southeast-1

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ---- storage (optional) -------------------------------------------------
# Without it, trips are kept in memory and lost on restart. /health says which.
# DATABASE_URL=postgresql://...
